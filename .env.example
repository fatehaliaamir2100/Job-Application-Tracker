# ─── Local development ─────────────────────────────────────────────────────────
# Gmail API Configuration
# Get these from: https://console.cloud.google.com/
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Ollama Configuration
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434   # local dev

# Database
DATABASE_URL=sqlite:///./job_tracker.db

# Application Settings
SYNC_INTERVAL_MINUTES=60
MAX_EMAILS_PER_SYNC=50

# Backend Server
HOST=0.0.0.0
PORT=8000

# ─── Docker (docker-compose handles these automatically) ───────────────────────
# OLLAMA_BASE_URL=http://ollama:11434   # service name inside compose network
# GMAIL_CREDENTIALS_FILE=/data/credentials.json
# GMAIL_TOKEN_FILE=/data/token.json
# DATABASE_URL=sqlite:////data/job_tracker.db
